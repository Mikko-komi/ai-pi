  "nodes": [
    {
      "id": "file:packages/protocol/src/cbor/decoder.ts",
      "type": "file",
      "name": "decoder.ts",
      "filePath": "packages/protocol/src/cbor/decoder.ts",
      "summary": "实现协议用的严格 RFC 8949 CBOR 子集解码：只接受单条 definite-length 载荷，拒绝 tag、不定长与尾随字节。",
      "tags": ["cbor", "decoder", "protocol", "反序列化", "rfc-8949"],
      "complexity": "moderate",
      "languageNotes": "CborReader 按 major type 分派，整数限制在 Number.isSafeInteger 范围内。"
    },
    {
      "id": "function:packages/protocol/src/cbor/decoder.ts:decodeCbor",
      "type": "function",
      "name": "decodeCbor",
      "filePath": "packages/protocol/src/cbor/decoder.ts",
      "lineRange": [161, 168],
      "summary": "校验 Uint8Array 输入并解析选项后，用 CborReader 解码恰好一项 CBOR 值。",
      "tags": ["cbor", "decoder", "入口点", "validation"],
      "complexity": "simple"
    },
    {
      "id": "class:packages/protocol/src/cbor/decoder.ts:CborReader",
      "type": "class",
      "name": "CborReader",
      "filePath": "packages/protocol/src/cbor/decoder.ts",
      "lineRange": [10, 158],
      "summary": "基于偏移的字节读取器，按 RFC 8949 major type 递归解码整数、字节串、文本、数组、字符串键 map 与简单值。",
      "tags": ["cbor", "decoder", "reader", "递归解析"],
      "complexity": "complex"
    },
    {
      "id": "function:packages/protocol/src/cbor/decoder.ts:readItem",
      "type": "function",
      "name": "readItem",
      "filePath": "packages/protocol/src/cbor/decoder.ts",
      "lineRange": [26, 86],
      "summary": "读取一个 CBOR 项：检查嵌套深度，解析 major type，并递归处理容器；拒绝 tag 与未知类型。",
      "tags": ["cbor", "decoder", "递归", "major-type"],
      "complexity": "complex"
    },
    {
      "id": "function:packages/protocol/src/cbor/decoder.ts:readSimple",
      "type": "function",
      "name": "readSimple",
      "filePath": "packages/protocol/src/cbor/decoder.ts",
      "lineRange": [88, 110],
      "summary": "解码 major type 7 的简单值：false/true/null 以及有限的 float64，拒绝 break 与其他宽度。",
      "tags": ["cbor", "decoder", "float64", "simple-value"],
      "complexity": "moderate"
    },
    {
      "id": "function:packages/protocol/src/cbor/decoder.ts:readArgument",
      "type": "function",
      "name": "readArgument",
      "filePath": "packages/protocol/src/cbor/decoder.ts",
      "lineRange": [119, 143],
      "summary": "按 additional information 读取 0–8 字节无符号参数，并将 64 位值限制在 JS 安全整数范围内。",
      "tags": ["cbor", "decoder", "integer", "additional-info"],
      "complexity": "moderate"
    },
    {
      "id": "file:packages/protocol/src/cbor/encoder.ts",
      "type": "file",
      "name": "encoder.ts",
      "filePath": "packages/protocol/src/cbor/encoder.ts",
      "summary": "将 JS 值编码为协议的 definite-length RFC 8949 子集，拒绝循环、空洞数组、非字符串键与不安全整数。",
      "tags": ["cbor", "encoder", "protocol", "序列化", "rfc-8949"],
      "complexity": "moderate",
      "languageNotes": "用 ancestors Set 做循环检测；文本先 UTF-8 编码再回解码以校验 Unicode scalar。"
    },
    {
      "id": "class:packages/protocol/src/cbor/encoder.ts:CborWriter",
